# NEAR AI Cloud (cloud.near.ai). Create the key by hand; never commit .env.
NEARAI_API_KEY=
NEARAI_BASE_URL=
# Optional: model override (default z-ai/glm-5.3-flash, fallback Qwen/Qwen3.8-27B)
NEARAI_MODEL=
# live = call NEAR AI Cloud, mock = canned answers, no network (ADR-33)
NEARAI_MODE=

# --- Onboarding (npm run agent -- onboarding/run.ts) ---
# sandbox or testnet; the owner key folder comes from the umbrella account script (KEYS_DIR/<network>/<account>.json)
ONBOARD_NETWORK=
ONBOARD_RPC_URL=
KEYS_DIR=
# Circle contract account; agent account = <name>.<CIRCLE_CONTRACT>
CIRCLE_CONTRACT=
CIRCLE_ID=
# sha256 hex of the circle terms approved by the owner
TERMS_HASH=
# Stake per agent in USDT smallest units (6 decimals)
STAKE_AMOUNT=
# Owner spend policy file, e.g. config/spend-policy.example.json
SPEND_POLICY_FILE=
# Sandbox only: mock USDT token account
USDT_TOKEN_ID=

# --- x207 seller (optional; empty = the agent serves for free) ---
# Facilitator URL; if set, CIRCLE_CONTRACT is required and the /api/<verb> endpoints are paid through x207
FACILITATOR_URL=
# Price per call, e.g. $0.02
AGENT_PRICE=
