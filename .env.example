# NEAR AI Cloud (cloud.near.ai). Create the key by hand; never commit .env.
NEARAI_API_KEY=
NEARAI_BASE_URL=
# Optional: model override (default z-ai/glm-5.3-flash, fallback Qwen/Qwen3.8-27B)
NEARAI_MODEL=
# live = call NEAR AI Cloud, mock = canned answers, no network (ADR-33)
NEARAI_MODE=

# --- Onboarding (npm run agent -- onboarding/run.ts) ---
# sandbox atau testnet; folder kunci pemilik dari skrip akun payung (KEYS_DIR/<network>/<akun>.json)
ONBOARD_NETWORK=
ONBOARD_RPC_URL=
KEYS_DIR=
# Akun kontrak lingkaran; akun agent = <nama>.<CIRCLE_CONTRACT>
CIRCLE_CONTRACT=
CIRCLE_ID=
# sha256 hex dari syarat lingkaran yang disetujui pemilik
TERMS_HASH=
# Stake per agent dalam satuan terkecil USDT (6 desimal)
STAKE_AMOUNT=
# Berkas kebijakan belanja pemilik, mis. config/spend-policy.example.json
SPEND_POLICY_FILE=
# Hanya sandbox: akun token USDT tiruan
USDT_TOKEN_ID=
